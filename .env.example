# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# MongoDB Configuration (use ?authSource=admin when credentials are needed)
MONGODB_URI=mongodb://localhost:27017/message_brokers
# With auth: mongodb://admin:admin@localhost:27017/message_brokers?authSource=admin

# API Service
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=debug
